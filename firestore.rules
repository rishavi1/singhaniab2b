rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "tpTCwK8nigTcCbgy43a0QaLJxxe2"; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['name','phone','shopName','address','email','status','createdAt','savedLocations','customAnswers'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.shopName is string
        && request.resource.data.address is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && (!('savedLocations' in request.resource.data) || (request.resource.data.savedLocations is list && request.resource.data.savedLocations.size() <= 3))
        && (!('customAnswers' in request.resource.data) || request.resource.data.customAnswers is map);
      allow read: if owns(uid) || isAdmin();
      allow update: if isAdmin()
        || (owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','shopName','address','email','savedLocations','updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['savedLocations'])
            || (request.resource.data.savedLocations is list
              && request.resource.data.savedLocations.size() <= 3)));
      allow delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid && request.resource.data.name is string && request.resource.data.price is number && request.resource.data.stock is number;
      allow update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','customerName','email','phone','address','note','items','total','status','createdAt'])
        && request.resource.data.customerName is string && request.resource.data.phone is string && request.resource.data.address is string
        && request.resource.data.items is string && request.resource.data.total is number && request.resource.data.status == 'pending'
        && (!('savedLocations' in request.resource.data) || (request.resource.data.savedLocations is list && request.resource.data.savedLocations.size() <= 3))
        && (!('customAnswers' in request.resource.data) || request.resource.data.customAnswers is map);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if isAdmin();
    }
    match /returnRequests/{id} {
      allow create: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasOnly(['userId','orderId','reason','details','status','createdAt'])
        && request.resource.data.status == 'submitted'
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if isAdmin();
    }
    match /siteSettings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}